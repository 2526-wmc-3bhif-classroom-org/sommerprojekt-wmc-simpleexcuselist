*.log
server_output.log
logs

# VCS / tooling
.git
.gitignore
.gitattributes
.eslintcache
.vscode
.idea

# Docs, assets, and tests not needed at runtime
docs
pictures
coverage
__screenshots__
cypress
**/__tests__
test-login.*

# Docker files themselves
Dockerfile
.dockerignore
